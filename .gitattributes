# Normalize line endings across platforms.
* text=auto eol=lf

# Explicit text types
*.rs        text eol=lf
*.toml      text eol=lf
*.svelte    text eol=lf
*.ts        text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.svg       text eol=lf
*.yml       text eol=lf

# Windows batch scripts must keep CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary types (never convert)
*.png       binary
*.ico       binary
*.icns      binary
*.bin       binary
