{
  "$schema": "https://opencode.ai/config.json",

  // Single-model policy: Big Pickle only. Backed up by `.opencode/plugins/big-pickle-only.ts`.
  "model": "opencode/big-pickle",
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "opencode", "effect": "allow" }
  ],

  "instructions": [".opencode/instructions/*.md"],

  // Context management shared by every HELIX-Origin repository.
  "compaction": {
    "auto": true,
    "keep": { "tokens": 20000 },
    "buffer": 24000
  },
  "tool_output": {
    "max_lines": 1500,
    "max_bytes": 51200
  },
  "media": {
    "image": {
      "auto_resize": true,
      "max_width": 1600,
      "max_height": 1600,
      "max_base64_bytes": 4194304
    }
  },

  "experimental": {
    "todo": true,
    "subagent_depth": 1,
    "background_compaction": true,
    "location_idle_timeout": "4 hours"
  }
}
