{
  // Standalone type-check project for the OpenCode plugin sources. No project build includes this
  // folder, so this config keeps editor diagnostics meaningful without touching the repository
  // toolchain. Check it with: tsc -p .opencode/tsconfig.json
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["types/**/*.d.ts", "plugins/**/*.ts"]
}
