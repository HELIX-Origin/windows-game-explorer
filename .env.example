# Windows Game Explorer - Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and should NEVER be committed.

# Code signing certificate thumbprint (optional)
# WINDOWS_CERT_THUMBPRINT=your-cert-thumbprint-here

# GitHub PAT for winget submission (optional)
# PAT_TOKEN=your-github-pat-here

# Code signing certificate (base64-encoded PFX, for CI/CD)
# CODE_SIGNING_CERT_BASE64=base64-encoded-pfx-content
# CODE_SIGNING_CERT_PASSWORD=your-pfx-password
# CODE_SIGNING_CERT_THUMBPRINT=your-cert-thumbprint